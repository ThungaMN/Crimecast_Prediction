# Loading Library

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split,cross_val_score
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.metrics import accuracy_score, confusion_matrix, classification_report

# EDA

train_data=pd.read_csv('/kaggle/input/crime-cast-forecasting-crime-categories/train.csv')
train_data.shape
test_data=pd.read_csv('/kaggle/input/crime-cast-forecasting-crime-categories/test.csv')
test_data.shape

# Data Preprocessing

target_feature = 'Crime_Category'
X = train_data.drop(columns=[target_feature])
y = train_data[target_feature]

# filling missing value

cat_cols = X.select_dtypes(include=['object']).columns
num_cols = X.select_dtypes(include=['float64', 'int64']).columns

# Imputers for missing values

imputer_constant = SimpleImputer(strategy='constant', fill_value='missing')
imputer = SimpleImputer(strategy='most_frequent')

# Transformers for categorical and numerical features
categorical_transformer = Pipeline(steps=[
    ('imputer', imputer_constant),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])

numerical_transformer = Pipeline(steps=[
    ('imputer', imputer),
    ('scaler', StandardScaler())
])

# Column Transformer
preprocessor = ColumnTransformer(
    transformers=[
        ('num', numerical_transformer, num_cols),
        ('cat', categorical_transformer, cat_cols)
    ])

preprocessor
# Train_Test_Split
X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.35, random_state=42)
X_train.shape, y_train.shape, X_val.shape, y_val.shape, test_data.shape
# Model Building & finding accuracy
from sklearn.ensemble import GradientBoostingClassifier

GB_model = Pipeline([
    ('preprocessor', preprocessor),
    ('classifier', GradientBoostingClassifier(random_state=42))
])

GB_model.fit(X_train, y_train)

Accuracy_On_Train_Data_GB = GB_model.score(X_train, y_train)
Accuracy_On_Test_Data_GB = GB_model.score(X_val, y_val)

print("Accuracy on Train Data:", Accuracy_On_Train_Data_GB)
print("Accuracy on Test Data:", Accuracy_On_Test_Data_GB)

# Cross-validation
scores = cross_val_score(GB_model, X, y, cv=5)
print("Cross-validation scores:", scores)
print("Average cross-validation score:", scores.mean())
# Predicting Test_data
test_pred=GB_model.predict(test_data)
test_pred


